{
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2022",
    "jsx": "react-jsx",
    "allowImportingTsExtensions": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "importHelpers": true,
    "allowJs": true
  },
  "include": ["src"],
  "exclude": ["node_modules", "**/node_modules/*"]
}
